NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-server-secret-key
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead.
JARVIS_BRIDGE_TOKEN=generate-at-least-32-random-bytes
# Independent HMAC key for one-time /link codes. If omitted, the bridge token
# is used as a backwards-compatible server-only fallback.
TELEGRAM_LINK_CODE_SECRET=generate-another-at-least-32-random-bytes
# Temporary migration-only fallback for Daniel's existing bot destination.
JARVIS_BRIDGE_LEGACY_TELEGRAM_USER_ID=123456789
JARVIS_BRIDGE_OWNER_ID=your-auth-user-uuid

# One-time/private importer only (normally exported in the shell, not committed).
UNAB_OS_OWNER_ID=your-auth-user-uuid
TEMA_DATA_ROOT=/home/you/.local/share/unab-os/tema

# Railway cron TEMA Sync. TEMA_TOKEN is server-only; never expose or commit it.
TEMA_TOKEN=your-moodle-mobile-token

# Optional. Defaults to the local Jarvis project used on this workstation.
JARVIS_BRIDGE_PATH=/absolute/path/to/jarvis-telegram/data/university-os-bridge
TEMA_CREDENTIALS_KEY=

# Academic Collaboration Beta
ACADEMIC_COLLABORATION_ENABLED=false
ACADEMIC_CURRENT_TERM_KEY=2026-2
NEXT_PUBLIC_ENABLE_TEST_ACCESS=false
