{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.tema-sync",
    "watchPatterns": ["scripts/sync_tema_cloud.py", "scripts/tema_sync_schedule.py", "scripts/tema_file_identity.py", "scripts/tema_snapshot_policy.py", "scripts/requirements-tema-sync.txt", "Dockerfile.tema-sync"]
  },
  "deploy": {
    "startCommand": "python scripts/sync_tema_cloud.py",
    "cronSchedule": "*/10 * * * *",
    "restartPolicyType": "NEVER"
  }
}
